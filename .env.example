# MeteoVoid - example environment for European radar sources.
#
# Copy to `.env` for local runs, or set these as GitHub Actions secrets for CI.
# NEVER commit a real key. The public site (GitHub Pages) only ever receives
# booleans (configured/enabled) and statuses - never a key value.

# --- Sources with a free key / free account -------------------------------
# Spain (AEMET OpenData): key requested by email, quota 40 connections/minute.
AEMET_API_KEY=
# France (Météo-France Données Radar): open access with account, ~850 req / 5 min.
METEOFRANCE_API_KEY=
# Netherlands (KNMI Data Platform): registered key recommended.
KNMI_API_KEY=
# Europe pivot (EUMETNET OPERA ORD via MeteoGate): anonymous possible, key recommended.
METEOGATE_API_KEY=

# --- Keyless sources (on/off switches) ------------------------------------
RAINVIEWER_ENABLED=true          # visual layer only, not machine proof
METEOSWISS_STAC_ENABLED=true     # Swiss radar open data (STAC), no key
DWD_OPEN_DATA_ENABLED=true       # Germany RADOLAN/RADKLIM open data, no key
DMI_RADAR_ENABLED=false          # Denmark radar API, no key (northern extension)

# --- Per-country live detection (Open-Meteo observations + native convective) ---
# When true, the per-country pages use real Open-Meteo data (incl. native
# CAPE / CIN / lifted_index / pressure-level winds for shear) instead of the
# deterministic offline proxy.
METEOVOID_ENABLE_LIVE_COUNTRY=false

# Optional: point a country to a real radar file (ODIM HDF5 / GeoTIFF) to
# compute machine-radar metrics and promote the source to machine evidence.
# METEOVOID_RADAR_FILE_FRANCE=/path/to/france_frame.h5
# METEOVOID_RADAR_FILE_NETHERLANDS=/path/to/nl_frame.h5

# --- Guardrails -----------------------------------------------------------
METEOVOID_RADAR_CACHE_MINUTES=10
METEOVOID_RADAR_MAX_REQUESTS_PER_RUN=50
METEOVOID_RADAR_REQUIRE_ATTRIBUTION=true
